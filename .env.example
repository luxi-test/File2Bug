# 复制为 .env；默认演示模式不会调用飞书写接口。
F2B_MODE=demo
F2B_DATABASE=data/fail2bug.db
# 局域网使用时改为 0.0.0.0，并将 BASE_URL 改为本机局域网 IP。
F2B_HOST=127.0.0.1
F2B_BASE_URL=http://127.0.0.1:8000

# 实际接入时设 F2B_MODE=live，并填写以下值。
F2B_APP_ID=
F2B_APP_SECRET=
F2B_TARGET_APP_TOKEN=
F2B_TARGET_TABLE_ID=
F2B_TARGET_URL=
F2B_SOURCE_URL=

# 缺陷库至少需要这些字段，可通过环境变量修改字段名。
F2B_FIELD_TITLE=缺陷标题
F2B_FIELD_STEPS=复现步骤
F2B_FIELD_EXPECTED=预期结果
F2B_FIELD_ACTUAL=实际结果
F2B_FIELD_PRIORITY=优先级
F2B_FIELD_REPORTER=提交人
F2B_FIELD_VERSION=版本
F2B_FIELD_DEVICE=测试设备
F2B_FIELD_ENVIRONMENT=环境
F2B_FIELD_CASE_ID=关联用例

# 可选字段；留空就不写入。
F2B_FIELD_EVIDENCE=
F2B_FIELD_STATUS=
F2B_INITIAL_STATUS=Open(QA)
F2B_FIELD_PROJECT=
F2B_FIELD_SOURCE=
F2B_DEFAULT_PROJECT=
F2B_DEFAULT_REPORTER=
F2B_DEFAULT_REPORTER_NAME=
F2B_DEFAULT_ENVIRONMENT=
F2B_FIELD_PROBLEM_TYPE=
F2B_FIELD_MODULE=
F2B_FIELD_SUBMODULE=
F2B_FIELD_FREQUENCY=
F2B_FIELD_ATTACHMENTS=
F2B_MAX_ATTACHMENT_MB=200
F2B_MAX_IMPORT_MB=200

# 本地演示不需要。live 模式必填；通过页面输入，勿放入链接。
F2B_ACCESS_KEY=
# 机器人只接受这些用户的 open_id（逗号分隔）；live 模式启用机器人时必填。
F2B_ALLOWED_USERS=
